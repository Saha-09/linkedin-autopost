# ─── Copy to .env for local runs. In GitHub Actions, set these as repo secrets. ───

# LLM that drafts the posts. Pick ONE provider.
# Options: "gemini" (free tier), "groq" (free tier), "anthropic", "openai"
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
# Optional model override (sensible default chosen per provider if blank)
LLM_MODEL=

# ─── LinkedIn (from your Developer app + one-time OAuth) ───
LINKEDIN_ACCESS_TOKEN=your_60_day_access_token
LINKEDIN_REFRESH_TOKEN=            # may be empty if your app wasn't issued one
LINKEDIN_CLIENT_ID=your_app_client_id
LINKEDIN_CLIENT_SECRET=your_app_client_secret
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX   # your member id, from get_token.py

# ─── Telegram (use a SEPARATE bot from your market-brief bot) ───
TELEGRAM_BOT_TOKEN=your_linkedin_bot_token
TELEGRAM_CHAT_ID=your_personal_chat_id

# ─── Optional: feed your market brief in as source material ───
# Raw URL to today's brief, or leave blank to run on the topic bank alone.
MARKET_BRIEF_URL=
